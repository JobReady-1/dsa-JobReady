# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5174

# Supabase — required for DB persistence
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT secret for verifying Supabase tokens
# Find it in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Leave blank in dev to use userId from request body (no token required)
# Set in production to enforce token verification

# ─── Judge0 (preferred code execution backend, 60+ languages) ────────────────
# Option A — self-hosted (recommended, free):
#   git clone https://github.com/judge0/judge0 && cd judge0 && docker-compose up -d
#   JUDGE0_URL=http://localhost:2358
# Option B — RapidAPI hosted:
#   JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=your_rapidapi_key
# Leave blank to fall back to Docker sandbox, then local execution.
JUDGE0_URL=
JUDGE0_API_KEY=
